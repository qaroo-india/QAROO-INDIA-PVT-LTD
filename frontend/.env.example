# Frontend build-time variables. Anything prefixed VITE_ is embedded in the
# bundle and is therefore PUBLIC - never put a secret here.
#
# Copy to .env.production (gitignored) or set these in your build environment.

# The API origin, used as `${VITE_API_BASE_URL}/auth/refresh` and so on, so it
# MUST include the /api suffix. Leave unset for a same-origin deploy, where the
# default '/api' is correct.
#   correct : https://api.qaroo.in/api
#   wrong   : https://api.qaroo.in        (every request 404s)
VITE_API_BASE_URL=

# Optional flags, both default to off.
VITE_BETA_MODE=
VITE_DEBUG_CRASH_LOGS=
