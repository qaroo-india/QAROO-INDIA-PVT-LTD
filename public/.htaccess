# Qaroo India — SPA fallback for Apache/cPanel static hosting.
# Needed so direct visits or refreshes on nested routes
# (e.g. /learning-programs/<slug>) return index.html instead of 404.

RewriteEngine On
RewriteBase /

# Serve existing files and directories as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else falls back to the React app.
RewriteRule ^ index.html [L]